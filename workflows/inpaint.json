{
 "kitchen": {
  "name": "Inpaint (node lõi ComfyUI)",
  "kind": "edit",
  "image": [
   "reference",
   "mask"
  ],
  "description": "Sửa vùng mask trên ảnh gốc. Chỉ cần checkpoint (tốt nhất là bản inpaint, vd SDXL inpainting).",
  "default": {
   "steps": 28,
   "cfg": 6.0
  }
 },
 "prompt": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "{{ckpt}}"
   }
  },
  "2": {
   "class_type": "LoadImage",
   "inputs": {
    "image": "{{reference}}"
   }
  },
  "3": {
   "class_type": "LoadImageMask",
   "inputs": {
    "image": "{{mask}}",
    "channel": "red"
   }
  },
  "4": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "{{prompt}}",
    "clip": [
     "1",
     1
    ]
   }
  },
  "5": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "{{negative}}",
    "clip": [
     "1",
     1
    ]
   }
  },
  "6": {
   "class_type": "VAEEncodeForInpaint",
   "inputs": {
    "pixels": [
     "2",
     0
    ],
    "vae": [
     "1",
     2
    ],
    "mask": [
     "3",
     0
    ],
    "grow_mask_by": 6
   }
  },
  "7": {
   "class_type": "KSampler",
   "inputs": {
    "model": [
     "1",
     0
    ],
    "positive": [
     "4",
     0
    ],
    "negative": [
     "5",
     0
    ],
    "latent_image": [
     "6",
     0
    ],
    "seed": "{{seed}}",
    "steps": "{{steps}}",
    "cfg": "{{cfg}}",
    "sampler_name": "dpmpp_2m",
    "scheduler": "karras",
    "denoise": 1.0
   }
  },
  "8": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "7",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "9": {
   "class_type": "SaveImage",
   "inputs": {
    "images": [
     "8",
     0
    ],
    "filename_prefix": "kitchen_edit"
   }
  }
 }
}
