{
 "kitchen": {
  "name": "Inpaint + ControlNet lineart",
  "kind": "edit",
  "image": [
   "reference",
   "mask",
   "lines"
  ],
  "description": "Như inpaint, thêm ControlNet lineart từ lines.png (đã đảo: nét trắng nền đen) để giữ đúng mép cánh.",
  "default": {
   "steps": 28,
   "cfg": 6.0,
   "cn_strength": 0.8
  }
 },
 "prompt": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "{{ckpt}}"
   }
  },
  "2": {
   "class_type": "LoadImage",
   "inputs": {
    "image": "{{reference}}"
   }
  },
  "3": {
   "class_type": "LoadImageMask",
   "inputs": {
    "image": "{{mask}}",
    "channel": "red"
   }
  },
  "4": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "{{prompt}}",
    "clip": [
     "1",
     1
    ]
   }
  },
  "5": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "{{negative}}",
    "clip": [
     "1",
     1
    ]
   }
  },
  "6": {
   "class_type": "VAEEncodeForInpaint",
   "inputs": {
    "pixels": [
     "2",
     0
    ],
    "vae": [
     "1",
     2
    ],
    "mask": [
     "3",
     0
    ],
    "grow_mask_by": 6
   }
  },
  "7": {
   "class_type": "KSampler",
   "inputs": {
    "model": [
     "1",
     0
    ],
    "positive": [
     "12",
     0
    ],
    "negative": [
     "12",
     1
    ],
    "latent_image": [
     "6",
     0
    ],
    "seed": "{{seed}}",
    "steps": "{{steps}}",
    "cfg": "{{cfg}}",
    "sampler_name": "dpmpp_2m",
    "scheduler": "karras",
    "denoise": 1.0
   }
  },
  "8": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "7",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "9": {
   "class_type": "SaveImage",
   "inputs": {
    "images": [
     "8",
     0
    ],
    "filename_prefix": "kitchen_edit"
   }
  },
  "10": {
   "class_type": "LoadImage",
   "inputs": {
    "image": "{{lines}}"
   }
  },
  "11": {
   "class_type": "ControlNetLoader",
   "inputs": {
    "control_net_name": "{{controlnet_lineart}}"
   }
  },
  "12": {
   "class_type": "ControlNetApplyAdvanced",
   "inputs": {
    "positive": [
     "4",
     0
    ],
    "negative": [
     "5",
     0
    ],
    "control_net": [
     "11",
     0
    ],
    "image": [
     "10",
     0
    ],
    "strength": "{{cn_strength}}",
    "start_percent": 0.0,
    "end_percent": 1.0
   }
  }
 }
}
