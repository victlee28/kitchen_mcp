# Sao chép thành .env (được nạp tự động, không ghi đè biến môi trường có sẵn)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
KITCHEN_DB=
KITCHEN_RENDERS=
KITCHEN_PORT=8080
# Sửa ảnh theo lớp — ComfyUI (tùy chọn; không có thì dùng backend to-mau hoặc goi-job)
COMFYUI_URL=http://127.0.0.1:5557
COMFYUI_CKPT=sd_xl_base_1.0.safetensors
COMFYUI_CN_LINEART=controlnet-lineart-sdxl.safetensors
COMFYUI_CN_DEPTH=controlnet-depth-sdxl.safetensors
COMFYUI_TIMEOUT=600
# Gemini (backend "gemini"): đặt khóa trực tiếp hoặc trỏ tới .env đã có khóa (vd của mcp-image)
GEMINI_API_KEY=
GEMINI_ENV_FILE=
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_SIZE=
GEMINI_TIMEOUT=300
# backend chọn sẵn trên web: to-mau | goi-job | comfyui | gemini
KITCHEN_IMAGE_BACKEND=comfyui
