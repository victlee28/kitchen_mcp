# Sao chép thành .env (được nạp tự động, không ghi đè biến môi trường có sẵn)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
KITCHEN_DB=
KITCHEN_RENDERS=
KITCHEN_PORT=8080
# Gemini (backend "gemini"): đặt khóa trực tiếp hoặc trỏ tới .env đã có khóa (vd của mcp-image)
GEMINI_API_KEY=
GEMINI_ENV_FILE=
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_SIZE=
GEMINI_TIMEOUT=300
# backend chọn sẵn trên web: recolor | job-package | gemini
KITCHEN_IMAGE_BACKEND=gemini

# cabinet-recognizer (services/cabinet-recognizer): bộ nhận diện tủ bếp từ ảnh/bản vẽ. Chỉ đọc biến môi trường của tiến trình
# (không tự nạp .env): nạp .env vào shell hoặc đặt biến trước khi chạy `python -m cabinet_recognizer`.
# RECOG_PROVIDER: anthropic | openai (OpenAI-compatible: OpenAI, Gemini, OpenRouter...) | ollama (cục bộ)
RECOG_PROVIDER=anthropic
RECOG_MODEL=
RECOG_BASE_URL=
# KHÓA API của nhà cung cấp đang chọn ở RECOG_PROVIDER (RECOG_API_KEY KHÔNG riêng của Claude):
#   provider=openai + Gemini endpoint (đang đặt)  -> RECOG_API_KEY = khóa GEMINI (lấy ở aistudio.google.com)
#   provider=anthropic (Claude)                   -> điền ANTHROPIC_API_KEY (hoặc RECOG_API_KEY = khóa Claude)
#   provider=openai + OpenAI/OpenRouter           -> OPENAI_API_KEY (hoặc RECOG_API_KEY = khóa của nơi đó)
#   provider=ollama                               -> không cần khóa
# RECOG_API_KEY, nếu có, được ưu tiên; để trống thì dùng ANTHROPIC_API_KEY / OPENAI_API_KEY theo provider.
RECOG_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RECOG_REGION=VN
RECOG_TIMEOUT_S=120
RECOG_MAX_RETRIES=1

# Nhận diện ảnh qua dịch vụ cabinet-recognizer riêng (khóa API nằm trong tiến trình đó, không ở đây). Chạy dịch vụ:
#   cd services/cabinet-recognizer && python -m cabinet_recognizer.http_server --port 8765
CABINET_RECOGNIZER_URL=
CABINET_RECOGNIZER_TIMEOUT=240
# Bộ nhận diện dùng khi yêu cầu không nêu tên: cabinet | gemini (để trống: cabinet nếu có URL, không thì gemini)
# De trong = uu tien: inbox (KHONG goi API: tao job, nhan Claude Desktop tra loi hop thu, bam "Cap nhat" o menu chuot phai) > cabinet (model API RECOG_*) > gemini.
# Dat cabinet | gemini | inbox de ep dung mot bo.
KITCHEN_RECOGNIZER=

# Cau lenh go o menu chuot phai: inbox (mac dinh) = gui vao hop thu lenh cua Claude; nhan Claude "lam cac lenh trong hop thu",
# Claude doc va thuc hien qua MCP server kitchen-design (list_menu_commands -> ... -> apply_change -> answer_menu_command).
# direct = server tu doc cau lenh va hien ban xem truoc ngay nhu truoc.
KITCHEN_MENU_COMMANDS=inbox
# Thu muc hop thu lenh (de trong: command-inbox/ canh kitchen.db). Web server va MCP server phai dung chung thu muc nay.
KITCHEN_COMMAND_INBOX=

# ---- Model ngon ngu cho phan doc cau lenh / worker hop thu (cong model chung: kitchen/model_gateway.py)
# KITCHEN_LLM_PROVIDER: anthropic | openai | deepseek | openrouter | ollama  (de trong: deepseek neu co DEEPSEEK_API_KEY, nhu truoc)
KITCHEN_LLM_PROVIDER=
# Model cua hang do (anthropic mac dinh claude-sonnet-5-5; openai / openrouter / ollama: bat buoc ghi)
KITCHEN_LLM_MODEL=
# Dia chi khac cung dinh dang (proxy, may chu trong LAN, vd http://192.168.1.20:11434/v1 cho Ollama)
KITCHEN_LLM_BASE_URL=
# Hang du phong khi hang chinh loi: provider[:model], vd openai:gpt-x
KITCHEN_LLM_FALLBACK=
KITCHEN_LLM_TIMEOUT=60
OPENROUTER_API_KEY=
# Han muc moi ngay cho moi loi goi model (0 = khong gioi han). USD chi tinh duoc khi data/model-prices.json co gia.
KITCHEN_MODEL_BUDGET_TOKENS=0
KITCHEN_MODEL_BUDGET_USD=0
# Worker tu lam cac lenh trong hop thu (khong can nhan chat): auto (mac dinh: co API thi AI tu lam, khong co thi cho nhan Claude) | on | off.
# Model: KITCHEN_INBOX_PROVIDER (provider[:model]) hoac KITCHEN_LLM_PROVIDER. Model loi / het han muc: lenh van cho, nhan Claude de lam.
KITCHEN_INBOX_WORKER=auto
KITCHEN_INBOX_PROVIDER=
# Backend tao anh "openai": OPENAI_API_KEY + model anh (mac dinh gpt-image-1)
OPENAI_IMAGE_MODEL=
# MCP qua mang LAN (python server.py --http): khoa bat buoc, >= 16 ky tu. Moi request gui "Authorization: Bearer <khoa>".
# Host 127.0.0.1 = chi may nay; 0.0.0.0 = may khac trong LAN goi duoc (mo cong tren Windows Firewall, mang Private). Khong mo ra Internet.
KITCHEN_MCP_TOKEN=
KITCHEN_MCP_HOST=127.0.0.1
KITCHEN_MCP_PORT=8766
