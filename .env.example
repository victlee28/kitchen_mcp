# Sao chép thành .env (được nạp tự động, không ghi đè biến môi trường có sẵn)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
KITCHEN_DB=
KITCHEN_RENDERS=
KITCHEN_PORT=8080
# Gemini (backend "gemini"): đặt khóa trực tiếp hoặc trỏ tới .env đã có khóa (vd của mcp-image)
GEMINI_API_KEY=
GEMINI_ENV_FILE=
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_SIZE=
GEMINI_TIMEOUT=300
# backend chọn sẵn trên web: recolor | job-package | gemini
KITCHEN_IMAGE_BACKEND=gemini

# cabinet-recognizer (services/cabinet-recognizer): bộ nhận diện tủ bếp từ ảnh/bản vẽ. Chỉ đọc biến môi trường của tiến trình
# (không tự nạp .env): nạp .env vào shell hoặc đặt biến trước khi chạy `python -m cabinet_recognizer`.
# RECOG_PROVIDER: anthropic | openai (OpenAI-compatible: OpenAI, Gemini, OpenRouter...) | ollama (cục bộ)
RECOG_PROVIDER=anthropic
RECOG_MODEL=
RECOG_BASE_URL=
# KHÓA API của nhà cung cấp đang chọn ở RECOG_PROVIDER (RECOG_API_KEY KHÔNG riêng của Claude):
#   provider=openai + Gemini endpoint (đang đặt)  -> RECOG_API_KEY = khóa GEMINI (lấy ở aistudio.google.com)
#   provider=anthropic (Claude)                   -> điền ANTHROPIC_API_KEY (hoặc RECOG_API_KEY = khóa Claude)
#   provider=openai + OpenAI/OpenRouter           -> OPENAI_API_KEY (hoặc RECOG_API_KEY = khóa của nơi đó)
#   provider=ollama                               -> không cần khóa
# RECOG_API_KEY, nếu có, được ưu tiên; để trống thì dùng ANTHROPIC_API_KEY / OPENAI_API_KEY theo provider.
RECOG_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RECOG_REGION=VN
RECOG_TIMEOUT_S=120
RECOG_MAX_RETRIES=1

# Nhận diện ảnh qua dịch vụ cabinet-recognizer riêng (khóa API nằm trong tiến trình đó, không ở đây). Chạy dịch vụ:
#   cd services/cabinet-recognizer && python -m cabinet_recognizer.http_server --port 8765
CABINET_RECOGNIZER_URL=
CABINET_RECOGNIZER_TIMEOUT=240
# Bộ nhận diện dùng khi yêu cầu không nêu tên: cabinet | gemini (để trống: cabinet nếu có URL, không thì gemini)
# De trong = uu tien: inbox (KHONG goi API: tao job, nhan Claude Desktop tra loi hop thu, bam "Cap nhat" o menu chuot phai) > cabinet (model API RECOG_*) > gemini.
# Dat cabinet | gemini | inbox de ep dung mot bo.
KITCHEN_RECOGNIZER=
