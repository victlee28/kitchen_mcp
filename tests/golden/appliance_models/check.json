{
 "function": "appliance_models.check",
 "cases": [
  {
   "name": "L fixture: no models, nothing checked",
   "input": {
    "spec": {
     "$fixture": "fixtures/l-shaped-kitchen.json"
    }
   },
   "expected": {
    "issues": []
   }
  },
  {
   "name": "75 cm gas hob in a 630 cabinet (wall rows)",
   "input": {
    "spec": {
     "$fixture": "fixtures/l-shaped-kitchen.json"
    },
    "ops": [
     {
      "op": "update-appliance",
      "id": "TB4",
      "model": "hob-gas-2b-75"
     }
    ]
   },
   "expected": {
    "issues": [
     [
      "APPLIANCE-MODEL-FIT",
      "error",
      [
       "TB4",
       "TD4"
      ],
      "TB4 (Bếp gas âm 2 họng 75 cm): Lỗ khoét 650 mm rộng hơn lòng tủ TD4 (594 mm): cần tủ rộng ít nhất 686 mm"
     ],
     [
      "HOOD-WIDTH",
      "warning",
      [
       "TB5",
       "TB4"
      ],
      "Máy hút mùi TB5 (730 mm) hẹp hơn bếp TB4 bên dưới (750 mm)"
     ]
    ]
   }
  },
  {
   "name": "the same after the rows became runs",
   "input": {
    "spec": {
     "$fixture": "fixtures/l-shaped-kitchen.json"
    },
    "convertRows": true,
    "ops": [
     {
      "op": "update-appliance",
      "id": "TB4",
      "model": "hob-gas-2b-75"
     }
    ]
   },
   "expected": {
    "issues": [
     [
      "APPLIANCE-MODEL-FIT",
      "error",
      [
       "TB4",
       "TD4"
      ],
      "TB4 (Bếp gas âm 2 họng 75 cm): Lỗ khoét 650 mm rộng hơn lòng tủ TD4 (594 mm): cần tủ rộng ít nhất 686 mm"
     ],
     [
      "HOOD-WIDTH",
      "warning",
      [
       "TB5",
       "TB4"
      ],
      "Máy hút mùi TB5 (730 mm) hẹp hơn bếp TB4 bên dưới (750 mm)"
     ]
    ]
   }
  },
  {
   "name": "double sink in the corner sink cabinet fits",
   "input": {
    "spec": {
     "$fixture": "fixtures/l-shaped-kitchen.json"
    },
    "ops": [
     {
      "op": "update-appliance",
      "id": "TB2",
      "model": "sink-double-82"
     }
    ]
   },
