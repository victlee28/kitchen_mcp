    "oz": 0,
    "x": 5,
    "z": 7
   },
   "expected": {
    "x": 5.0,
    "z": 7.0
   }
  },
  {
   "name": "yaw 90: +x of the kitchen runs to -z of the room",
   "input": {
    "yaw": 90,
    "ox": 100,
    "oz": 200,
    "x": 10,
    "z": 0
   },
   "expected": {
    "x": 100.0,
    "z": 190.0
   }
  },
  {
   "name": "yaw 90: +z of the kitchen runs to +x of the room",
   "input": {
    "yaw": 90,
    "ox": 100,
    "oz": 200,
    "x": 0,
    "z": 10
   },
   "expected": {
    "x": 110.0,
    "z": 200.0
   }
  },
  {
   "name": "yaw 180 is a half turn",
   "input": {
    "yaw": 180,
    "ox": 5000,
