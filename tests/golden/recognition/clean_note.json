{
 "function": "recognition.recognizer_wire.clean_note",
 "cases": [
  {
   "name": "plain text is kept",
   "input": {
    "text": "white shaker doors, fridge on the left"
   },
   "expected": {
    "note": "white shaker doors, fridge on the left"
   }
  },
  {
   "name": "whitespace and control characters collapse",
   "input": {
    "text": "  a\u0000b \n\n  c\t d  "
   },
   "expected": {
    "note": "a b c d"
   }
  },
  {
   "name": "cut at 500 characters",
   "input": {
    "text": ""
   },
   "expected": {
    "note": ""
   }
  },
  {
   "name": "not a text",
   "input": {
    "text": null
   },
   "expected": {
    "note": ""
   }
  },
  {
   "name": "Vietnamese is kept",
   "input": {
    "text": "  tủ bếp màu trắng, cánh phẳng  "
   },
   "expected": {
    "note": "tủ bếp màu trắng, cánh phẳng"
   }
  }
 ]
}
