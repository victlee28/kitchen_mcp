{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "handle",
 "type": "object",
 "required": [
  "label",
  "variant"
 ],
 "additionalProperties": false,
 "properties": {
  "label": {
   "type": "object",
   "required": [
    "vi"
   ],
   "properties": {
    "vi": {
     "type": "string"
    },
    "en": {
     "type": "string"
    }
   },
   "additionalProperties": false,
   "x-label": {
    "vi": "Tên",
    "en": "Name"
   }
  },
  "brand": {
   "type": "string",
   "x-label": {
    "vi": "Hãng",
    "en": "Brand"
   }
  },
  "code": {
   "type": "string",
   "x-label": {
    "vi": "Mã sản phẩm",
    "en": "Product code"
   }
  },
  "variant": {
   "enum": [
    "bar",
    "knob",
    "concealed",
    "none"
   ],
   "x-label": {
    "vi": "Kiểu",
    "en": "Kind"
   }
  },
  "length": {
   "type": "number",
   "minimum": 0,
   "x-label": {
    "vi": "Chiều dài tay thanh (mm)",
    "en": "Bar length (mm)"
   }
  },
  "size": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "width": {
     "type": "number",
     "minimum": 0
    },
    "height": {
     "type": "number",
     "minimum": 0
    },
    "depth": {
     "type": "number",
     "minimum": 0
    }
   },
   "x-label": {
    "vi": "Kích thước (mm)",
    "en": "Size (mm)"
   }
  },
  "holeSpacing": {
   "type": "number",
   "minimum": 0,
   "x-label": {
    "vi": "Khoảng cách lỗ vít (mm)",
    "en": "Hole spacing (mm)"
   }
  },
  "material": {
   "type": "string",
   "x-label": {
    "vi": "Vật liệu / màu",
    "en": "Material / finish"
   }
  },
  "price": {
   "type": "object",
   "required": [
    "amount",
    "currency"
   ],
   "additionalProperties": false,
   "properties": {
    "amount": {
     "type": "number",
     "minimum": 0
    },
    "currency": {
     "type": "string",
     "pattern": "^[A-Z]{3}$"
    }
   },
   "x-label": {
    "vi": "Giá",
    "en": "Price"
   }
  },
  "note": {
   "type": "object",
   "required": [
    "vi"
   ],
   "properties": {
    "vi": {
     "type": "string"
    },
    "en": {
     "type": "string"
    }
   },
   "additionalProperties": false,
   "x-label": {
    "vi": "Ghi chú",
    "en": "Note"
   }
  }
 }
}
