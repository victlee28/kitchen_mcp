    "vi": "Vùng sửa nhỏ nhất (điểm ảnh)",
    "en": "Smallest edit region (pixels)"
   }
  },
  "minAppliancePixels": {
   "type": "number",
   "minimum": 0,
   "x-label": {
    "vi": "Thiết bị nhỏ hơn thì không mô tả (điểm ảnh)",
    "en": "Appliance below this is not described (pixels)"
   }
  }
 }
}