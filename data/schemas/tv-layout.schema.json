{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "tv-layout",
 "type": "object",
 "required": [
  "label",
  "steps"
 ],
 "additionalProperties": false,
 "$defs": {
  "step": {
   "type": "object",
   "required": [
    "do"
   ],
   "additionalProperties": false,
   "properties": {
    "do": {
     "type": "string",
     "enum": [
      "cabinets",
      "tv",
      "let"
     ]
    },
    "when": {
     "type": "string",
     "minLength": 1
    },
    "group": {
     "type": "string"
    },
    "type": {
     "type": "string"
    },
    "start": {
     "type": "string",
     "minLength": 1
    },
    "length": {
     "type": "string",
     "minLength": 1
    },
    "split": {
     "type": "string",
     "minLength": 1
    },
    "y": {
     "type": "string",
     "minLength": 1
    },
    "height": {
     "type": "string",
     "minLength": 1
    },
    "depth": {
     "type": "string",
     "minLength": 1
    },
    "name": {
     "type": "string"
    },
    "drawer": {
     "type": "boolean"
    },
    "shelfCount": {
     "type": "integer",
     "minimum": 0
    },
    "front": {
     "type": "boolean"
    },
    "on": {
     "type": "string"
    },
    "center": {
     "type": "string",
     "minLength": 1
    },
    "fit": {
     "type": "string",
     "minLength": 1
    },
    "panel": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "width",
      "y0",
      "y1"
     ],
     "properties": {
      "width": {
       "type": "string",
       "minLength": 1
      },
      "y0": {
       "type": "string",
       "minLength": 1
      },
      "y1": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "vars": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 },
 "properties": {
  "label": {
   "type": "object",
   "properties": {
    "vi": {
     "type": "string"
    },
    "en": {
     "type": "string"
    }
   },
   "required": [
    "vi"
   ],
   "additionalProperties": false,
   "x-label": {
    "vi": "Tên",
    "en": "Name"
   }
  },
  "vars": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "minLength": 1
   },
   "x-label": {
    "vi": "Biến (công thức)",
    "en": "Values (formulas)"
   }
  },
  "steps": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/step"
   },
   "x-label": {
    "vi": "Các bước",
    "en": "Steps"
   }
  }
 }
}
