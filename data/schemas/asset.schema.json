{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "asset",
 "type": "object",
 "required": [
  "category",
  "geometryType",
  "defaultDimensions"
 ],
 "additionalProperties": false,
 "properties": {
  "category": {
   "type": "string",
   "minLength": 1,
   "x-label": {
    "vi": "Nhóm",
    "en": "Category"
   }
  },
  "geometryType": {
   "type": "string",
   "enum": [
    "panel",
    "box",
    "procedural",
    "extrusion"
   ],
   "x-label": {
    "vi": "Kiểu hình",
    "en": "Geometry type"
   }
  },
  "defaultDimensions": {
   "type": "array",
   "items": {
    "type": "number",
    "exclusiveMinimum": 0
   },
   "minItems": 3,
   "maxItems": 3,
   "x-label": {
    "vi": "Kích thước mặc định (rộng, cao, sâu; mm)",
    "en": "Default size (width, height, depth; mm)"
   }
  },
  "parameters": {
   "type": "object",
   "x-label": {
    "vi": "Tham số",
    "en": "Parameters"
   }
  }
 }
}
