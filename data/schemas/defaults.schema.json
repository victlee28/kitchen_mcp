{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "defaults",
 "type": "object",
 "required": [
  "newDesign",
  "run",
  "stretch",
  "applianceHole",
  "menu"
 ],
 "additionalProperties": false,
 "properties": {
  "newDesign": {
   "type": "object",
   "required": [
    "cabinetTop",
    "countertopThickness",
    "countertopOverhang",
    "doorThickness",
    "doorGap",
    "backThickness"
   ],
   "additionalProperties": false,
   "properties": {
    "cabinetTop": {
     "type": "number",
     "minimum": 1500,
     "x-label": {
      "vi": "Đỉnh tủ trên (mm)",
      "en": "Top of wall cabinets (mm)"
     },
     "maximum": 3200
    },
    "countertopThickness": {
     "type": "number",
     "minimum": 10,
     "x-label": {
      "vi": "Dày mặt đá",
      "en": "Countertop thickness"
     },
     "maximum": 100
    },
    "countertopOverhang": {
     "type": "number",
     "minimum": 0,
     "x-label": {
      "vi": "Mặt đá nhô trước",
      "en": "Countertop overhang"
     },
     "maximum": 100
    },
    "doorThickness": {
     "type": "number",
     "minimum": 10,
     "x-label": {
      "vi": "Dày cánh",
      "en": "Door thickness"
     },
     "maximum": 40
    },
    "doorGap": {
     "type": "number",
     "minimum": 0,
     "x-label": {
      "vi": "Khe cánh",
      "en": "Door gap"
     },
     "maximum": 10
    },
    "backThickness": {
     "type": "number",
     "minimum": 3,
     "x-label": {
      "vi": "Dày hậu",
      "en": "Back panel thickness"
     },
     "maximum": 25
    }
   },
   "x-label": {
    "vi": "Thiết kế mới (khi câu lệnh không nói)",
    "en": "New designs (when the request does not say)"
   }
  },
  "run": {
   "type": "object",
   "required": [
    "moduleWidth",
    "minWidth",
    "maxRun",
    "cornerMaxWidth"
   ],
   "additionalProperties": false,
   "properties": {
    "moduleWidth": {
     "type": "number",
     "minimum": 300,
     "x-label": {
      "vi": "Rộng tủ ưa dùng",
      "en": "Preferred cabinet width"
     },
     "maximum": 1200
    },
    "minWidth": {
     "type": "number",
     "minimum": 100,
     "x-label": {
      "vi": "Tủ hẹp nhất",
      "en": "Narrowest cabinet"
     },
     "maximum": 600
    },
    "maxRun": {
     "type": "number",
     "minimum": 1000,
     "x-label": {
      "vi": "Dãy dài nhất làm một lần",
      "en": "Longest run made at once"
     },
     "maximum": 20000
    },
    "cornerMaxWidth": {
     "type": "number",
     "minimum": 600,
     "x-label": {
      "vi": "Tủ góc rộng nhất",
      "en": "Widest corner cabinet"
     },
     "maximum": 2000
    }
   },
   "x-label": {
    "vi": "Chia dãy tủ",
    "en": "Splitting a run"
   }
  },
  "stretch": {
   "type": "object",
   "required": [
    "min",
    "max"
   ],
   "additionalProperties": false,
   "properties": {
    "min": {
     "type": "number",
     "minimum": 50,
     "x-label": {
      "vi": "Kéo dãy: tủ hẹp nhất",
      "en": "Stretch: narrowest cabinet"
     },
     "maximum": 600
    },
    "max": {
     "type": "number",
     "minimum": 600,
     "x-label": {
      "vi": "Kéo dãy: tủ rộng nhất",
      "en": "Stretch: widest cabinet"
     },
     "maximum": 3000
    }
   },
   "x-label": {
    "vi": "Kéo đầu dãy",
    "en": "Dragging a run end"
   }
  },
  "applianceHole": {
   "type": "object",
   "required": [
    "side",
    "worktopEdge",
    "hoodSide"
   ],
   "additionalProperties": false,
   "properties": {
    "side": {
     "type": "number",
     "minimum": 5,
     "x-label": {
      "vi": "Hông tủ",
      "en": "Side panel"
     },
     "maximum": 40
    },
    "worktopEdge": {
     "type": "number",
     "minimum": 0,
     "x-label": {
      "vi": "Mặt đá chừa trước/sau lỗ khoét",
      "en": "Countertop left around a cut-out"
     },
     "maximum": 200
    },
    "hoodSide": {
     "type": "number",
     "minimum": 0,
     "x-label": {
      "vi": "Khe mỗi bên hút mùi âm tủ",
      "en": "Room each side of an integrated hood"
     },
     "maximum": 50
    }
   },
   "x-label": {
    "vi": "Lắp thiết bị",
    "en": "Fitting appliances"
   }
  },
  "menu": {
   "type": "object",
   "required": [
    "addWidthMin",
    "addWidthMax",
    "overhangMax",
    "runShiftMax",
    "stretchMax"
   ],
   "additionalProperties": false,
   "properties": {
    "addWidthMin": {
     "type": "number",
     "minimum": 50,
     "x-label": {
      "vi": "Thêm tủ: rộng tối thiểu",
      "en": "Add cabinet: min width"
     },
     "maximum": 600
    },
    "addWidthMax": {
     "type": "number",
     "minimum": 300,
     "x-label": {
      "vi": "Thêm tủ: rộng tối đa",
      "en": "Add cabinet: max width"
     },
     "maximum": 3000
    },
    "overhangMax": {
     "type": "number",
     "minimum": 0,
     "x-label": {
      "vi": "Độ nhô mặt đá tối đa",
      "en": "Max countertop overhang"
     },
     "maximum": 300
    },
    "runShiftMax": {
     "type": "number",
     "minimum": 100,
     "x-label": {
      "vi": "Dời dãy tối đa",
      "en": "Max run move"
     },
     "maximum": 50000
    },
    "stretchMax": {
     "type": "number",
     "minimum": 50,
     "x-label": {
      "vi": "Kéo đầu dãy tối đa mỗi lần",
      "en": "Max end drag at once"
     },
     "maximum": 5000
    }
   },
   "x-label": {
    "vi": "Giới hạn nhập trên menu",
    "en": "Menu input limits"
   }
  },
  "materials": {
   "type": "object",
   "additionalProperties": false,
   "x-label": {
    "vi": "Vật liệu mặc định (khi thiết kế không ghi)",
    "en": "Default finishes (where a design names none)"
   },
   "properties": {
    "base": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Mặt cánh tủ dưới",
      "en": "Base cabinet fronts"
     }
    },
    "upper": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Mặt cánh tủ trên",
      "en": "Wall cabinet fronts"
     }
    },
    "cornerShelf": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Kệ góc mở",
      "en": "Open corner shelf"
     }
    },
    "carcass": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Thùng tủ",
      "en": "Carcass"
     }
    },
    "countertop": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Mặt đá",
      "en": "Countertop"
     }
    },
    "wallTile": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Gạch ốp tường bếp",
      "en": "Backsplash"
     }
    },
    "wall": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Tường",
      "en": "Wall"
     }
    },
    "floor": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Sàn",
      "en": "Floor"
     }
    },
    "plinth": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Chân tủ",
      "en": "Toe kick"
     }
    },
    "molding": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Phào chỉ",
      "en": "Molding"
     }
    },
    "glass": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Kính cánh tủ",
      "en": "Cabinet door glass"
     }
    },
    "steel": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Thiết bị inox",
      "en": "Stainless appliances"
     }
    },
    "sink": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Chậu rửa",
      "en": "Sink"
     }
    },
    "cooktop": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Mặt bếp",
      "en": "Cooktop"
     }
    },
    "openings": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Thiết bị âm tủ",
      "en": "Built-in appliances"
     }
    },
    "openingFrame": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Khung, nẹp cửa phòng",
      "en": "Room door and window frames"
     }
    },
    "openingLeaf": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Cánh cửa đi phòng",
      "en": "Room door leaves"
     }
    },
    "openingGlass": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Kính cửa sổ, ô thoáng",
      "en": "Window and transom glass"
     }
    },
    "openingHandle": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Tay nắm cửa đi, cửa sổ",
      "en": "Door and window handles"
     }
    }
   }
  },
  "openings": {
   "type": "object",
   "additionalProperties": false,
   "x-label": {
    "vi": "Kiểm cửa đi, cửa sổ",
    "en": "Door and window checks"
   },
   "properties": {
    "clearAllowance": {
     "type": "number",
     "minimum": 0,
     "maximum": 300,
     "x-label": {
      "vi": "Lỗ cửa → thông thủy: trừ khung và cánh (mm)",
      "en": "Opening to clear width: frame and leaf (mm)"
     }
    },
    "doorZone": {
     "type": "number",
     "minimum": 0,
     "maximum": 1500,
     "x-label": {
      "vi": "Vùng trước/sau cửa đi tính là lối cửa (mm)",
      "en": "Depth in front of a door counted as its doorway (mm)"
     }
    },
    "windowZone": {
     "type": "number",
     "minimum": 0,
     "maximum": 1500,
     "x-label": {
      "vi": "Vùng trước cửa sổ tính là dưới cửa sổ (mm)",
      "en": "Depth in front of a window counted as under it (mm)"
     }
    },
    "near": {
     "type": "number",
     "minimum": 0,
     "maximum": 10000,
     "x-label": {
      "vi": "Cửa xa tủ hơn mức này là của phòng khác (mm)",
      "en": "Openings further than this from every cabinet belong to another room (mm)"
     }
    },
    "snapTolerance": {
     "type": "number",
     "minimum": 0,
     "maximum": 100,
     "x-label": {
      "vi": "Dung sai bắt khổ cửa (mm)",
      "en": "Opening size snap tolerance (mm)"
     }
    },
    "windowSill": {
     "type": "number",
     "minimum": 0,
     "maximum": 3000,
     "x-label": {
      "vi": "Cửa sổ cách sàn khi không ghi (mm)",
      "en": "Window sill above the floor when none is given (mm)"
     }
    }
   }
  },
  "hinge": {
   "type": "object",
   "additionalProperties": false,
   "x-label": {
    "vi": "Bản lề cánh tủ",
    "en": "Cabinet door hinges"
   },
   "properties": {
    "item": {
     "type": "string",
     "x-label": {
      "vi": "Bản lề mặc định (mã trong danh mục)",
      "en": "Default hinge (catalog id)"
     }
    },
    "edge": {
     "type": "number",
     "minimum": 30,
     "maximum": 300,
     "x-label": {
      "vi": "Bản lề trên/dưới cách mép cánh (mm)",
      "en": "Top and bottom hinge from the door edge (mm)"
     }
    },
    "counts": {
     "type": "array",
     "minItems": 1,
     "x-label": {
      "vi": "Số bản lề theo chiều cao cánh",
      "en": "Hinges per door by door height"
     },
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "upTo",
       "count"
      ],
      "properties": {
       "upTo": {
        "type": "number",
        "minimum": 100,
        "maximum": 4000,
        "x-label": {
         "vi": "Cánh cao tới (mm)",
         "en": "Door up to (mm)"
        }
       },
       "count": {
        "type": "integer",
        "minimum": 2,
        "maximum": 8,
        "x-label": {
         "vi": "Số bản lề",
         "en": "Hinges"
        }
       }
      }
     }
    }
   }
  },
  "autoPlace": {
   "type": "object",
   "additionalProperties": false,
   "x-label": {
    "vi": "Tự động đặt tủ và cửa theo mặt bằng",
    "en": "Auto place cabinets and doors from the floorplan"
   },
   "properties": {
    "cabinetTags": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "x-label": {
      "vi": "Nhãn (tag) được coi là tủ",
      "en": "Tags that mean a cabinet"
     }
    },
    "kitchenTags": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "x-label": {
      "vi": "Nhãn tủ bếp",
      "en": "Tags of a kitchen"
     }
    },
    "tvTags": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "x-label": {
      "vi": "Nhãn tủ tivi",
      "en": "Tags of a TV unit"
     }
    },
    "unitTags": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "minLength": 1
     },
     "x-label": {
      "vi": "Nhãn → mẫu tủ (unit-layout)",
      "en": "Tag → unit layout"
     }
    },
    "kitchenWords": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "x-label": {
      "vi": "Từ trong tên cho biết là tủ bếp (không dấu)",
      "en": "Words of a name that mean a kitchen"
     }
    },
    "kitchenMinDepth": {
     "type": "number",
     "minimum": 0,
     "maximum": 2000,
     "x-label": {
      "vi": "Sâu từ mức này: tủ dưới (mm)",
      "en": "From this depth: base cabinets (mm)"
     }
    },
    "unitMinDepth": {
     "type": "number",
     "minimum": 0,
     "maximum": 2000,
     "x-label": {
      "vi": "Sâu từ mức này: tủ thấp, nông hơn bỏ qua (mm)",
      "en": "From this depth: low unit; shallower is skipped (mm)"
     }
    },
    "shallowUnit": {
     "type": "string",
     "minLength": 1,
     "x-label": {
      "vi": "Mẫu tủ cho vật nông",
      "en": "Unit layout of a shallow object"
     }
    }
   }
  }
 }
}
