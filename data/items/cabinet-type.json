 {
  "id": "upper-open",
  "storey": "upper",
  "label": {
   "vi": "Kệ mở",
   "en": "Open shelf"
  },
  "parts": [
   {
    "part": "side-panel",
    "s": [
     "fromCorner",
     "fromCorner + doorThickness"
    ],
    "d": [
     "0",
     "depth"
    ],
    "y": [
     "y",
     "top"
    ]
   },
   {
    "part": "side-panel",
    "s": [
     "endAt - doorThickness",
     "endAt"
    ],
    "d": [
     "0",
     "depth"
    ],
    "y": [
     "y",
     "top"
    ]
   },
   {
    "part": "carcass",
    "s": [
     "fromCorner + doorThickness",
     "endAt - doorThickness"
    ],
    "d": [
     "0",
     "12"
    ],
    "y": [
     "y",
     "top"
    ]
   },
   {
    "repeat": "max(1, shelfCount) + 1",
    "as": "i",
    "let": {
     "yb": "y + i * (height - doorThickness) / max(1, shelfCount)"
    },
    "parts": [
     {
      "part": "shelf",
      "s": [
       "fromCorner + doorThickness",
       "endAt - doorThickness"
      ],
      "d": [
       "0",
       "depth"
      ],
      "y": [
       "yb",
       "yb + doorThickness"
      ]
     }
    ]
   }
  ],
  "frontless": true,
  "prompt": "open shelving unit"
 },
