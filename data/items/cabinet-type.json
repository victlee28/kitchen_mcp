[
 {
  "id": "base",
  "storey": "base",
  "label": {
   "vi": "Tủ dưới",
   "en": "Base cabinet"
  },
  "let": {
   "body": "max(y, plinthHeight) if y == 0 else y"
  },
  "parts": [
   {
    "part": "plinth",
    "s": [
     "min(fs0, b0)",
     "max(fs1, b1)"
    ],
    "d": [
     "0",
     "depth - doorThickness - 50"
    ],
    "y": [
     "0",
     "plinthHeight"
    ],
    "when": "y == 0"
   },
   {
    "part": "side-panel",
    "s": [
     "p0",
     "p1"
    ],
    "d": [
     "0",
     "depth"
    ],
    "y": [
     "0",
     "top"
    ],
    "when": "endPanel != 0"
   },
   {
    "part": "carcass",
    "s": [
     "b0",
     "b1"
    ],
    "d": [
     "0",
     "depth"
    ],
    "y": [
     "body",
     "top"
    ],
    "when": "blindCorner != 0"
   },
   {
    "part": "carcass",
    "s": [
     "fs0",
     "fs1"
    ],
    "d": [
     "0",
     "depth - doorThickness"
    ],
    "y": [
     "body",
     "top"
    ],
    "when": "sections == 0"
   },
   {
    "when": "sections == 0",
    "fronts": "door",
    "s": [
     "fs0",
     "fs1"
    ],
    "y": [
     "body",
     "top"
    ]
   },
   {
    "when": "sections == 0",
    "special": "back-panel"
   },
   {
    "when": "sections != 0",
    "special": "front-sections",
    "s": [
     "fs0",
     "fs1"
    ],
    "y": [
     "body",
     "top"
    ]
   }
  ],
  "prompt": "base cabinet"
 },
